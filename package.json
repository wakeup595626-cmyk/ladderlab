{
  "name": "ladderlab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/finalize-build.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build",
    "qa": "node scripts/qa-smoke.mjs",
    "qa:project": "node scripts/qa-project-library.mjs",
    "qa:branch": "node scripts/qa-branch-details.mjs",
    "qa:sheet": "node scripts/qa-program-sheet.mjs",
    "qa:rungs": "node scripts/qa-rung-operations.mjs",
    "qa:storage": "node scripts/qa-storage-tabs.mjs",
    "qa:stress": "node scripts/qa-storage-stress.mjs",
    "qa:hardening": "node scripts/qa-hardening.mjs",
    "qa:accessibility": "node scripts/qa-accessibility.mjs",
    "qa:badge": "node scripts/qa-support-badge.mjs",
    "qa:touch": "node scripts/qa-responsive-touch.mjs",
    "qa:tags": "node scripts/qa-tags.mjs",
    "qa:tagsync": "node scripts/qa-tag-sync.mjs",
    "qa:save": "node scripts/qa-save-button.mjs",
    "qa:share": "node scripts/qa-share-link.mjs",
    "qa:a11y": "node scripts/qa-a11y.mjs",
    "qa:export": "node scripts/qa-export-svg.mjs",
    "qa:export-custom": "node scripts/qa-export-custom.mjs",
    "qa:perf": "node scripts/qa-perf-large.mjs",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "preview": "vite preview --strictPort"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.3",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
